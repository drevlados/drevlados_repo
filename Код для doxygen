#include <iostream>
#include <string>
#include <iomanip>
#include <cmath>
#include <random>

/**
 * \class BankAccount
 * \brief Класс, представляющий банковский счёт.
 *
 * Класс содержит основные операции по управлению банковским счётом:
 * пополнение, снятие средств и вывод информации о счёте.
 */
class BankAccount {
private:
    /// \brief Номер счёта.
    std::string accountNumber;
    /// \brief Баланс счёта.
    double balance;
    /// \brief Статус активности счёта (активен/неактивен).
    bool isActive;

public:
    /**
     * \brief Конструктор класса BankAccount.
     *
     * Создаёт новый банковский счёт с указанным номером и начальным балансом.
     * По умолчанию счёт создаётся активным.
     *
     * \param accNum Номер счёта (строка).
     * \param initialBalance Начальный баланс счёта (по умолчанию 0.0).
     */
    BankAccount(const std::string& accNum, double initialBalance = 0.0)
        : accountNumber(accNum), balance(initialBalance), isActive(true) {}

    /**
     * \brief Пополнение счёта.
     *
     * Добавляет указанную сумму к балансу счёта, если сумма положительна
     * и счёт активен.
     *
     * \param amount Сумма для пополнения (должна быть положительной).
     */
    void deposit(double amount) {
        if (amount > 0 && isActive) {
            balance += amount;
            std::cout << "Счёт пополнен на " << amount << " руб.\n";
        }
        else {
            std::cout << "Ошибка: Некорректная сумма или счёт неактивен.\n";
        }
    }

    /**
     * \brief Снятие средств со счёта.
     *
     * Снимает указанную сумму с баланса счёта, если сумма положительна,
     * не превышает текущий баланс и счёт активен.
     *
     * \param amount Сумма для снятия (должна быть положительной и не превышать баланс).
     */
    void withdraw(double amount) {
        if (amount > 0 && amount <= balance && isActive) {
            balance -= amount;
            std::cout << "Снято " << amount << " руб. со счёта.\n";
        }
        else {
            std::cout << "Ошибка: Недостаточно средств или счёт неактивен.\n";
        }
    }

    /**
     * \brief Вывод информации о счёте.
     *
     * Выводит на экран номер счёта, текущий баланс (в отформатированном виде)
     * и статус активности счёта.
     */
    void getAccountInfo() const {
        std::cout << "=== Информация о счёте ===\n";
        std::cout << "Номер счёта: " << accountNumber << "\n";
        std::cout << "Баланс: " << formatCurrency(balance) << "\n";
        std::cout << "Статус: " << (isActive ? "Активен" : "Неактивен") << "\n";
        std::cout << "========================\n";
    }
};

/**
 * \brief Расчёт сложных процентов.
 *
 * Вычисляет сумму начисленных процентов по формуле сложных процентов
 * за указанное количество лет.
 *
 * \param principal Начальная сумма (основная сумма вклада).
 * \param rate Процентная ставка (в процентах годовых).
 * \param years Количество лет.
 * \return Сумма начисленных процентов.
 */
double calculateInterest(double principal, double rate, int years) {
    return principal * pow(1 + rate / 100, years) - principal;
}

/**
 * \brief Форматирование суммы в виде валюты.
 *
 * Преобразует числовое значение в строку с двумя знаками после запятой
 * и добавлением обозначения валюты («руб.»).
 *
 * \param amount Сумма, которую нужно отформатировать.
 * \return Отформатированная строка с суммой и обозначением валюты.
 */
std::string formatCurrency(double amount) {
    std::ostringstream oss;
    oss << std::fixed << std::setprecision(2) << amount << " руб.";
    return oss.str();
}

/**
 * \brief Проверка корректности номера счёта.
 *
 * Проверяет, что номер счёта состоит ровно из 10 цифр.
 *
 * \param accountNum Номер счёта для проверки.
 * \return true, если номер счёта корректен, иначе false.
 */
bool isValidAccountNumber(const std::string& accountNum) {
    return accountNum.length() == 10 && std::all_of(accountNum.begin(),
        accountNum.end(), ::isdigit);
}

/**
 * \brief Конвертация валюты.
 *
 * Конвертирует сумму из одной валюты в другую по указанному обменному курсу.
 *
 * \param amount Исходная сумма.
 * \param exchangeRate Обменный курс (сколько единиц целевой валюты за одну единицу исходной).
 * \return Конвертированная сумма.
 */
double convertCurrency(double amount, double exchangeRate) {
    return amount * exchangeRate;
}

/**
 * \brief Генерация случайного номера счёта.
 *
 * Создаёт случайный 10‑значный номер счёта, состоящий только из цифр.
 * Использует генератор псевдослучайных чисел Mersenne Twister.
 *
 * \return Сгенерированный номер счёта в виде строки.
 */
std::string generateRandomAccountNumber() {
    static std::random_device rd;
    static std::mt19937 gen(rd());
    static std::uniform_int_distribution<> dis(0, 9);

    std::string number;
    for (int i = 0; i < 10; ++i) {
        number += std::to_string(dis(gen));
    }
    return number;
}

/**
 * \brief Основная функция программы.
 *
 * Демонстрирует работу класса BankAccount и отдельных функций:
 * создаёт счёт, выполняет операции пополнения и снятия, выводит информацию,
 * а также показывает работу вспомогательных функций.
 *
 * \return Код завершения программы (0 — успешное завершение).
 */
int main() {
    // Демонстрация работы класса
    std::cout << "Создаём банковский счёт...\n";
    std::string accNum = generateRandomAccountNumber();
    BankAccount myAccount(accNum, 1000.0);

    myAccount.getAccountInfo();

    myAccount.deposit(500.0);
    myAccount.withdraw(200.0);
    myAccount.getAccountInfo();

    // Демонстрация отдельных функций
    std::cout << "\n=== Демонстрация отдельных функций ===\n";

    double interest = calculateInterest(1000.0, 5.0, 3);
    std::cout << "Начисленные проценты: " << formatCurrency(interest) << "\n";

    std::cout << "Конвертация 100 USD в RUB (курс 90): "
        << formatCurrency(convertCurrency(100.0, 90.0)) << "\n";

    std::cout << "Корректен ли номер счёта " << accNum << "? "
        << (isValidAccountNumber(accNum) ? "Да" : "Нет") << "\n";

    return 0;
}
